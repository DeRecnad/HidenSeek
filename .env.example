# Скопируйте в .env и заполните. .env в .gitignore — в репозиторий не попадает.

# --- SMTP для кода подтверждения email (например, пароль приложения Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-password-here
SMTP_FROM=you@gmail.com

# --- GitHub OAuth App (Settings → Developer settings → OAuth Apps) ---
# Authorization callback URL: http://127.0.0.1:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Необязательно: токен повышает лимит запросов к GitHub API
GITHUB_TOKEN=

# --- HaveIBeenPwned (ключ платный; без него модуль помечается «недоступен») ---
HIBP_API_KEY=

# --- Параметры аудита ---
VERIFY_TTL_DAYS=90
AUDIT_MAX_DEPTH=2
AUDIT_MAX_FACTS=30
MODULE_RETRIES=2
MODULE_DELAY=1.0
# HIDENSEEK_DATA_DIR=./data

# --- Шифрование сохранённых аудитов (Fernet) ---
# По умолчанию включено, ключ создаётся в ~/.config/hidenseek/key (вне репозитория).
# HIDENSEEK_ENCRYPT=1
# HIDENSEEK_KEY_FILE=/путь/к/ключу
# HIDENSEEK_KEY=  # или сам ключ (Fernet, base64)

# --- ИИ-ассистент (Anthropic API) ---
# Без ключа ассистент отвечает заготовками. С ключом — только после согласия в интерфейсе.
ANTHROPIC_API_KEY=
# HIDENSEEK_ASSISTANT_MODEL=claude-opus-5-5

# --- Повторный аудит по расписанию: как часто сайт проверяет, не пора ли (секунды) ---
# SCHEDULER_INTERVAL=60
